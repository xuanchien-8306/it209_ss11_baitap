# ============================================================
# File .env.example - Mẫu biến môi trường
# Sao chép file này thành .env và điền giá trị thực tế
# ============================================================

# --- MySQL Container ---
MYSQL_DATABASE=studentdb
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password

# --- Spring Boot kết nối đến MySQL (trong Docker network) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=studentdb
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# --- Port ứng dụng Spring Boot ---
APP_PORT=8080
